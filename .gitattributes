# CRLF-native docs: these two files are committed with real CRLF line
# endings (not accidental drift), so `git diff --check` in CI's
# repository-safety job otherwise flags every changed line's trailing \r
# as a whitespace error and fails the build. whitespace=cr-at-eol tells
# git to treat CR-before-LF as normal for these paths.
# See docs/project-memory/DEPLOY_PLAYBOOK.md "Standing caution: this repo's CRLF/LF noise".
docs/project-memory/COWORK_HANDOFF.md whitespace=cr-at-eol
docs/project-memory/OPEN_ISSUES.md whitespace=cr-at-eol

# CRLF-native source: the two student leaderboard pages have been committed
# with CRLF line endings since they were written. Editing them in place
# (keeping CRLF, so the diff stays a few lines instead of the whole file)
# trips the same `git diff --check` rule as the docs above.
frontend/app/student/competition/leaderboard/page.tsx whitespace=cr-at-eol
frontend/app/student/competition/dps-leaderboard/page.tsx whitespace=cr-at-eol

# PDFs are binary; without this, git diff --check misreads xref-table
# byte sequences inside them as text whitespace violations (found via
# PR #518's repository-safety CI failure, 2026-09-07).
*.pdf binary
